{
  /**
   * ============================================================================
   * 文件：tsconfig.node.json — Node.js 环境的 TypeScript 配置
   * ============================================================================
   *
   * 【文件用途】
   * 专门用于编译运行在 Node.js 环境中的构建脚本文件（如 vite.config.ts）。
   * 这些代码不在浏览器中运行，而是在开发/构建时的 Node.js 进程中运行。
   *
   * 【在项目中的位置】
   * frontend/tsconfig.node.json
   * 被 tsconfig.json 通过 references 引用。
   *
   * 【与 tsconfig.app.json 的区别】
   * ┌──────────────────┬──────────────────────┬──────────────────────┐
   * │ 配置项           │ tsconfig.app.json    │ tsconfig.node.json   │
   * ├──────────────────┼──────────────────────┼──────────────────────┤
   * │ 运行环境        │ 浏览器               │ Node.js              │
   * │ 编译范围        │ src/**/*.ts/.vue      │ vite.config.ts       │
   * │ 类型支持        │ DOM、Vite Client     │ Node.js              │
   * │ 编译目标        │ (继承自 Vue 预设)     │ ES2023               │
   * │ 未使用变量检查   │ 宽松（false）         │ 严格（true）         │
   * └──────────────────┴──────────────────────┴──────────────────────┘
   * ============================================================================
   */

  "compilerOptions": {
    /**
     * "tsBuildInfoFile" — 增量编译缓存文件路径。
     * 与 tsconfig.app.json 的类似，但使用不同的文件名以避免冲突。
     */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    /**
     * "target" — TypeScript 编译的目标 ECMAScript 版本。
     *
     * "es2023" 表示将代码编译为 ES2023 标准的 JavaScript。
     * 因为 vite.config.ts 运行在 Node.js 环境中，Node.js 对现代
     * JavaScript 特性支持良好，所以可以使用较高的编译目标。
     *
     * 常见的 target 值：
     * - es5：兼容 IE 浏览器（最旧）
     * - es2015 (es6)：支持箭头函数、class、let/const 等
     * - es2020：支持可选链(?.)、空值合并(??)
     * - es2022：支持 top-level await
     * - es2023：最新标准，支持更多数组方法
     *
     * 【注意】
     * Vite 在开发模式下使用 esbuild 转译代码，不使用 tsc 编译。
     * 这个 target 主要影响 `vue-tsc` 类型检查时的行为。
     */
    "target": "es2023",

    /**
     * "lib" — 编译时可用的 API 类型声明库。
     *
     * "ES2023" 提供所有 ES2023 标准内置对象的类型声明（如 Promise、Array、Map 等）。
     * 不需要包含 "DOM"，因为 vite.config.ts 不在浏览器中运行。
     *
     * 常见的 lib 值：
     * - "ES2023"：ES2023 标准库
     * - "DOM"：浏览器 DOM API（document、window、HTMLElement 等）
     * - "DOM.Iterable"：DOM 集合的迭代器（如 document.all）
     */
    "lib": ["ES2023"],

    /**
     * "module" — 生成代码的模块系统。
     *
     * "esnext" 使用最新的 ES Module 语法（import/export）。
     * Node.js 从 v14 起原生支持 ES Module，所以可以使用这种格式。
     *
     * 常见的 module 值：
     * - "commonjs"：Node.js 传统的模块系统（require/module.exports）
     * - "es2015"：ES Module 的最初版本
     * - "esnext"：最新的 ES Module 规范
     */
    "module": "esnext",

    /**
     * "types" — 指定全局类型声明包。
     *
     * "node" 提供了 Node.js 的类型声明，包括：
     *   - process.env（环境变量）
     *   - __dirname、__filename（文件路径）
     *   - fs、path、http 等 Node.js 核心模块的类型
     *   - Buffer、Stream 等 Node.js 特有对象
     *
     * 安装来源：@types/node 包（在 devDependencies 中）
     */
    "types": ["node"],

    /**
     * "skipLibCheck" — 跳过对 .d.ts（类型声明）文件的类型检查。
     *
     * true 可以显著加快编译速度，因为不需要检查 node_modules 中的类型定义。
     * 缺点是可能遗漏第三方库类型定义中的错误，但这种情况很少见。
     *
     * 在大多数项目中建议设为 true，提升开发体验。
     */
    "skipLibCheck": true,

    // ====================================================================
    // Bundler 模式配置
    // ====================================================================

    /**
     * "moduleResolution" — 模块解析策略。
     *
     * "bundler" 是 TypeScript 5.0 新增的解析模式，专门为现代打包工具设计：
     *   - 支持 package.json 的 exports 字段
     *   - 支持相对路径导入省略扩展名
     *   - 与 Vite、Webpack 等工具的解析逻辑一致
     *
     * 其他可选值：
     * - "node10"：传统的 Node.js 解析策略（最保守）
     * - "node16" / "nodenext"：现代 Node.js 解析策略
     *
     * 【为什么选 bundler 而不是 node16？】
     * 因为 vite.config.ts 最终由 Vite（Rollup/esbuild）处理，
     * 而不是由 Node.js 直接运行。bundler 模式更贴近实际运行环境。
     */
    "moduleResolution": "bundler",

    /**
     * "allowImportingTsExtensions" — 允许在 import 中使用 .ts 扩展名。
     *
     * 传统上，TypeScript 的 import 不能包含 .ts 扩展名：
     *   import { foo } from './utils'      // 正确
     *   import { foo } from './utils.ts'   // 错误！
     *
     * 开启此选项后可以使用 .ts 扩展名，但需要配合 noEmit: true。
     * 这对于某些需要明确扩展名的工具链很有用。
     */
    "allowImportingTsExtensions": true,

    /**
     * "verbatimModuleSyntax" — 严格模块语法模式。
     *
     * true 要求 import type 和 export type 必须显式标注：
     *   import type { Foo } from './types'   // 纯类型导入，编译后会被移除
     *   import { bar } from './utils'        // 值导入，编译后保留
     *
     * 好处：
     * - 编译器可以更准确地区分类型导入和值导入
     * - 避免不必要的模块副作用（只导入类型的模块不会被执行）
     * - 更好的 tree-shaking 效果
     */
    "verbatimModuleSyntax": true,

    /**
     * "moduleDetection" — 模块检测策略。
     *
     * "force" 强制将所有文件视为模块（即使没有 import/export）。
     * 这样文件中的顶层变量不会泄漏到全局作用域，避免命名冲突。
     */
    "moduleDetection": "force",

    /**
     * "noEmit" — 不生成编译输出文件。
     *
     * true 表示 TypeScript 只进行类型检查，不生成 .js 文件。
     * 因为实际的代码转译由 Vite（esbuild）负责，比 tsc 快 10-100 倍。
     *
     * 【Vite 的 TypeScript 处理流程】
     * vue-tsc → 只做类型检查（noEmit: true）
     * esbuild → 只做语法转译（不做类型检查）
     * 两者分工合作，各司其职。
     */
    "noEmit": true,

    // ====================================================================
    // 代码质量检查（Linting）
    // ====================================================================

    /**
     * "noUnusedLocals" — 检查未使用的局部变量。
     * true 表示如果有声明但未使用的变量，编译器会报错。
     * 有助于保持代码整洁，发现无用的变量声明。
     */
    "noUnusedLocals": true,

    /**
     * "noUnusedParameters" — 检查未使用的函数参数。
     * true 表示如果有未使用的函数参数，编译器会报错。
     * 可以用 _ 前缀标记故意不使用的参数：function callback(_event, data) {}
     */
    "noUnusedParameters": true,

    /**
     * "erasableSyntaxOnly" — 只允许可擦除的 TypeScript 语法。
     * 与 tsconfig.app.json 中的含义相同。
     */
    "erasableSyntaxOnly": true,

    /**
     * "noFallthroughCasesInSwitch" — 禁止 switch case 穿透。
     * 与 tsconfig.app.json 中的含义相同。
     */
    "noFallthroughCasesInSwitch": true
  },

  /**
   * "include" — 只包含 vite.config.ts。
   * 这是唯一的编译目标文件，因为本配置专门用于 Node.js 环境的构建脚本。
   */
  "include": ["vite.config.ts"]
}
