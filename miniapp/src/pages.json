      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "记账"
      }
    },
    {
      "path": "pages/excerpt/excerpt",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "感悟摘录"
      }
    },
    {
      "path": "pages/profile/profile",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的"
      }
    }
  ],
  "subPackages": [
    {
      "root": "sub-pages",
      "pages": [
        {
          "path": "login/login",
          "style": {
            "navigationStyle": "custom",
            "navigationBarTitleText": "登录"
          }
        },
        {
          "path": "plan-add/plan-add",
          "style": {
            "navigationBarTitleText": "新建计划"
          }
        },
        {
          "path": "accounting-add/accounting-add",
          "style": {
            "navigationBarTitleText": "记一笔"
          }
        },
        {
          "path": "excerpt-add/excerpt-add",
          "style": {
            "navigationBarTitleText": "新增摘录"
          }
        },
        {
          "path": "summary/summary",
          "style": {
            "navigationBarTitleText": "每日总结"
          }
        },
        {
          "path": "goal/goal",
          "style": {
            "navigationBarTitleText": "目标管理"
          }
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "DailyTracker",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F7FA",
    "backgroundTextStyle": "dark",
    "backgroundColorTop": "#F5F7FA",
    "backgroundColorBottom": "#F5F7FA"
  },
  "tabBar": {
    "color": "#8E8E93",
    "selectedColor": "#6366F1",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/plan/plan",
        "text": "计划",
        "iconPath": "static/tabbar/plan.png",
        "selectedIconPath": "static/tabbar/plan-active.png"
      },
      {
        "pagePath": "pages/accounting/accounting",
        "text": "记账",
        "iconPath": "static/tabbar/wallet.png",
        "selectedIconPath": "static/tabbar/wallet-active.png"
      },
      {
        "pagePath": "pages/excerpt/excerpt",
        "text": "摘录",
        "iconPath": "static/tabbar/book.png",
        "selectedIconPath": "static/tabbar/book-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "static/tabbar/user.png",
        "selectedIconPath": "static/tabbar/user-active.png"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^dt-(.*)": "@/components/dt-$1/dt-$1.vue"
    }
  }
}
